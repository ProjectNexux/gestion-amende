DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
ADMIN_SOCIETE="Mon espace"
ADMIN_CODE="admin123"
# Base URL used to build shareable links (paiement, retard de paiement, client-setup access code)
NEXT_PUBLIC_APP_URL="https://gestion-amende.vercel.app"

# Scan depuis imprimante — réception email IMAP
EMAIL_HOST="imap.gmail.com"
EMAIL_PORT="993"
EMAIL_USER="scan@example.com"
EMAIL_PASSWORD="<mot-de-passe-application>"
EMAIL_SECURE="true"
SCAN_EMAIL_MAX_SIZE_MB="25"
SCAN_DEFAULT_SOCIETE="Societe principale"
NEXT_PUBLIC_SCAN_EMAIL="scan@example.com"
# Secret optionnel pour protéger l'endpoint de polling
SCAN_CRON_SECRET=""
# Intervalle (ms) du polling IMAP automatique en développement (0 = désactivé)
SCAN_POLL_INTERVAL_MS="60000"

# Envoi d'e-mails sortants (transmission automatique Comptabilité : Factures / Impôts)
# Réutilise par défaut EMAIL_USER/EMAIL_PASSWORD (même compte Gmail) via smtp.gmail.com.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
# Destinataires de la transmission automatique Factures/Impôts (séparés par des virgules)
COMPTABILITE_FORWARD_EMAILS="sfede@optimove.fr,wfede@optimove.fr,mboujelida@optimove.fr"
